{
    "prototype": true,
    "guides": [
        {
            "id": "vent-plasma",
            "label": "Vent Plasma",
            "summary": "Prepare the plasma vessel for the apparatus vent procedure. Gauges first, then the gate valve and its turbo, then every route to the QMS vessel, then the gas line.",
            "steps": [
                {
                    "action": "Switch off the plasma-side gauges.",
                    "desiredStatus": "inactive",
                    "targets": [
                        {"id": "upstream-single-gauge", "markerOffset": [26, -22]},
                        {"id": "bypass-ionization-gauge", "markerOffset": [26, -22]}
                    ]
                },
                {
                    "action": "Close the plasma gate valve and stop its turbo pump.",
                    "desiredStatus": "inactive",
                    "targets": [
                        {"id": "GVU", "markerOffset": [34, 0]},
                        {"id": "TMPU", "markerOffset": [0, -44]}
                    ]
                },
                {
                    "action": "Isolate the plasma vessel from the QMS vessel on every route between them.",
                    "desiredStatus": "inactive",
                    "targets": [
                        {"id": "valve_qms", "markerOffset": [0, -26]},
                        {"id": "GVBU", "markerOffset": [-30, 0]},
                        {"id": "GVBD", "markerOffset": [30, 0]},
                        {"id": "Rough-Bypass", "markerOffset": [0, 26]}
                    ]
                },
                {
                    "action": "Close the gas line into the plasma vessel.",
                    "desiredStatus": "inactive",
                    "targets": [
                        {"id": "gasline-main", "markerOffset": [-30, 0]}
                    ]
                },
                {
                    "manual": true,
                    "action": "Verify pressure on the physical instruments, then follow the apparatus vent procedure.",
                    "targets": [
                        {"id": "upstream-baratron", "markerOffset": [28, 20]}
                    ]
                }
            ],
            "alerts": [
                {
                    "when": [{"id": "upstream-single-gauge", "status": "active"}],
                    "text": "The plasma ionization gauge is marked on. Switch the gauges off first."
                },
                {
                    "when": [{"id": "TMPU", "status": "active"}, {"id": "GVU", "status": "active"}],
                    "text": "TMPU is marked running with the plasma gate open. Close the gate before the turbo stops."
                }
            ]
        },
        {
            "id": "vent-qms",
            "label": "Vent QMS",
            "summary": "Prepare the QMS vessel for the apparatus vent procedure. Gauges first, then the gate valve and its turbo, then every route to the plasma vessel.",
            "steps": [
                {
                    "action": "Switch off the QMS-side gauges.",
                    "desiredStatus": "inactive",
                    "targets": [
                        {"id": "downstream-ionization-gauge", "markerOffset": [28, -22]}
                    ]
                },
                {
                    "action": "Close the QMS gate valve and stop its turbo pump.",
                    "desiredStatus": "inactive",
                    "targets": [
                        {"id": "GVD", "markerOffset": [34, 0]},
                        {"id": "TMPD", "markerOffset": [0, -44]}
                    ]
                },
                {
                    "action": "Isolate the QMS vessel from the plasma vessel on every route between them.",
                    "desiredStatus": "inactive",
                    "targets": [
                        {"id": "valve_qms", "markerOffset": [0, -26]},
                        {"id": "GVBU", "markerOffset": [-30, 0]},
                        {"id": "GVBD", "markerOffset": [30, 0]},
                        {"id": "Rough-Bypass", "markerOffset": [0, 26]}
                    ]
                },
                {
                    "manual": true,
                    "action": "Verify pressure on the physical instruments, then follow the apparatus vent procedure.",
                    "targets": [
                        {"id": "downstream-baratron", "markerOffset": [28, 20]}
                    ]
                }
            ],
            "alerts": [
                {
                    "when": [{"id": "downstream-ionization-gauge", "status": "active"}],
                    "text": "The QMS ionization gauge is marked on. Switch it off first."
                },
                {
                    "when": [{"id": "TMPD", "status": "active"}, {"id": "GVD", "status": "active"}],
                    "text": "TMPD is marked running with the QMS gate open. Close the gate before the turbo stops."
                }
            ]
        }
    ]
}
