{
    "prototype": true,
    "guides": [
        {
            "id": "vent-plasma",
            "label": "Vent Plasma",
            "summary": "Bring the plasma vessel to atmosphere with nitrogen, so as little water as possible lands on the walls. Ionization gauges off first; Baratrons, Pirani and the membrane gauge stay on, they work at one atmosphere.",
            "steps": [
                {
                    "action": "Switch off the ionization gauges that see the plasma vessel.",
                    "desiredStatus": "inactive",
                    "targets": [
                        {"id": "bypass-ionization-gauge", "markerOffset": [26, -22]}
                    ]
                },
                {
                    "action": "Close the plasma gate valve and stop its turbo pump.",
                    "desiredStatus": "inactive",
                    "targets": [
                        {"id": "GVU", "markerOffset": [34, 0]},
                        {"id": "TMPU", "markerOffset": [0, -44]}
                    ]
                },
                {
                    "action": "Isolate the plasma vessel from the QMS vessel on every route between them.",
                    "desiredStatus": "inactive",
                    "targets": [
                        {"id": "valve_qms", "markerOffset": [0, -26]},
                        {"id": "GVBU", "markerOffset": [-30, 0]},
                        {"id": "GVBD", "markerOffset": [30, 0]},
                        {"id": "Rough-Bypass", "markerOffset": [0, 26]}
                    ]
                },
                {
                    "action": "Let nitrogen in: open the N2 valve on the gas panel and the gas line into the plasma vessel.",
                    "desiredStatus": "active",
                    "targets": [
                        {"id": "gaspanel-valve-n", "markerOffset": [0, -26]},
                        {"id": "gasline-main", "markerOffset": [-30, 0]}
                    ]
                },
                {
                    "manual": true,
                    "action": "Watch the Baratron climb to atmosphere, then open the vessel.",
                    "targets": [
                        {"id": "upstream-baratron", "markerOffset": [28, 20]}
                    ]
                }
            ],
            "alerts": [
                {
                    "when": [{"id": "bypass-ionization-gauge", "status": "active"}],
                    "text": "An ionization gauge is marked on. Switch it off before the pressure rises."
                },
                {
                    "when": [{"id": "TMPU", "status": "active"}, {"id": "GVU", "status": "active"}],
                    "text": "TMPU is marked running with the plasma gate open. Close the gate before the turbo stops."
                },
                {
                    "when": [{"id": "gasline-main", "status": "active"}, {"id": "GVU", "status": "active"}],
                    "text": "The gas line is open while the plasma gate is open: nitrogen would go to the turbo."
                }
            ]
        },
        {
            "id": "vent-qms",
            "label": "Vent QMS",
            "summary": "Bring the QMS vessel to atmosphere with nitrogen. Ionization gauge off first; the Baratron stays on, it works at one atmosphere.",
            "steps": [
                {
                    "action": "Switch off the QMS ionization gauge.",
                    "desiredStatus": "inactive",
                    "targets": [
                        {"id": "downstream-ionization-gauge", "markerOffset": [28, -22]}
                    ]
                },
                {
                    "action": "Close the QMS gate valve and stop its turbo pump.",
                    "desiredStatus": "inactive",
                    "targets": [
                        {"id": "GVD", "markerOffset": [34, 0]},
                        {"id": "TMPD", "markerOffset": [0, -44]}
                    ]
                },
                {
                    "action": "Isolate the QMS vessel from the plasma vessel on every route between them.",
                    "desiredStatus": "inactive",
                    "targets": [
                        {"id": "valve_qms", "markerOffset": [0, -26]},
                        {"id": "GVBU", "markerOffset": [-30, 0]},
                        {"id": "GVBD", "markerOffset": [30, 0]},
                        {"id": "Rough-Bypass", "markerOffset": [0, 26]}
                    ]
                },
                {
                    "manual": true,
                    "action": "Let nitrogen into the QMS vessel by its own route, watch the Baratron climb to atmosphere, then open the vessel.",
                    "targets": [
                        {"id": "downstream-baratron", "markerOffset": [28, 20]}
                    ]
                }
            ],
            "alerts": [
                {
                    "when": [{"id": "downstream-ionization-gauge", "status": "active"}],
                    "text": "The QMS ionization gauge is marked on. Switch it off before the pressure rises."
                },
                {
                    "when": [{"id": "TMPD", "status": "active"}, {"id": "GVD", "status": "active"}],
                    "text": "TMPD is marked running with the QMS gate open. Close the gate before the turbo stops."
                }
            ]
        }
    ]
}
